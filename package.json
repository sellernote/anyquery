{
  "name": "anyquery",
  "displayName": "AnyQuery",
  "version": "0.2.1",
  "description": "Query MySQL, PostgreSQL, MongoDB, Redis and OpenSearch in VS Code",
  "publisher": "seller-note",
  "author": "Wonsug Jung (https://github.com/gardenstone2)",
  "license": "MIT",
  "icon": "images/icon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sellernote/anyquery.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mysql",
    "postgresql",
    "mongodb",
    "redis",
    "opensearch",
    "database"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anyquery.open",
        "title": "Open",
        "category": "AnyQuery"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anyquery",
          "title": "AnyQuery",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "anyquery": [
        {
          "id": "anyquery.home",
          "name": "AnyQuery"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "anyquery.home",
        "contents": "AnyQuery opens in an editor tab.\n[Open AnyQuery](command:anyquery.open)"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.webview.json",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies",
    "install:package": "vsce package --no-dependencies --out out/anyquery.vsix && code --install-extension out/anyquery.vsix --force"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.6.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.101.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vscode/vsce": "^4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@vscode/vsce-sign"
    ]
  }
}
